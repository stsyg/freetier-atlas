# FreeTier Atlas — local development environment variables.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# These are NON-SECRET local development defaults. Never put real credentials in
# this file or in `.env`; `.env` is git-ignored. Production values are supplied
# by the deployment environment, not by the repository.

# --- PostgreSQL (used by the postgres service) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# --- API service ---
# SQLAlchemy URL. Inside Docker Compose the host is the `postgres` service name.
DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas  # pragma: allowlist secret
APP_ENV=development
API_PORT=8000
# Server secret for the public-adviser abuse layer (F007): keys the HMAC IP hash
# and signs the self-hosted proof-of-work challenges. NON-SECRET dev default;
# override with a strong random value in any deployed environment.
ABUSE_SECRET=dev-abuse-secret-change-me  # pragma: allowlist secret

# --- Private admin surface (F007 slice 4) ---
# Standard GitHub OAuth login restricted to an allowlist, with a stateless signed
# session cookie (stdlib HMAC; no session table, no JWT). All values here are
# NON-SECRET local development defaults.
# Master switch for the admin surface.
ADMIN_ENABLED=true
# GitHub OAuth app credentials. The client id is not secret; the client SECRET
# must be a real value supplied by the environment in any deployment and is never
# logged or audited. Empty defaults mean "not configured" -> login denies.
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=  # pragma: allowlist secret
# Server secret that signs the admin session cookie and CSRF tokens. NON-SECRET
# dev default; override with a strong random value in any deployed environment.
ADMIN_COOKIE_SIGNING_KEY=dev-admin-signing-key-change-me  # pragma: allowlist secret
# Comma-separated GitHub logins permitted to become admin.
ADMIN_ALLOWLIST=stsyg
# Public base URL of the app; used to build the OAuth redirect URI
# ({ADMIN_BASE_URL}/api/admin/callback).
ADMIN_BASE_URL=http://localhost:8080
# Set false only for a local HTTP smoke so a non-TLS client keeps the cookie.
ADMIN_COOKIE_SECURE=true
# Signed session / CSRF token lifetime, in seconds (default 8 hours).
ADMIN_SESSION_TTL_SECONDS=28800
# GitHub OAuth endpoints. Defaults target github.com; override for GitHub
# Enterprise / a self-hosted host (or an offline smoke double). Never networked
# to github.com in CI.
ADMIN_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
ADMIN_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token  # pragma: allowlist secret
ADMIN_OAUTH_USER_URL=https://api.github.com/user

# --- Worker & scheduler services ---
# Idle poll interval (seconds) for the worker claim loop.
WORKER_POLL_INTERVAL_SECONDS=2
# Enqueue interval (seconds) for the scheduler.
SCHEDULER_INTERVAL_SECONDS=5
# Freshness threshold (seconds) for the database-backed liveness health check.
HEARTBEAT_STALE_SECONDS=30

# --- Web frontend service ---
# Host port for the nginx-served React SPA (container listens on 80).
WEB_PORT=8080
# npm registry used when building the web image. Defaults to the public npm
# registry (portable). If your environment blocks or mirrors the public
# registry, set this to your approved feed/proxy; the committed lockfile keeps
# public URLs and npm remaps them to this registry automatically.
NPM_REGISTRY=https://registry.npmjs.org/
